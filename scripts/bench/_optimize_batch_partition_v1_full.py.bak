SINGLE_COLUMN_IN = 3.5
DOUBLE_COLUMN_IN = 7.16

Plan = Counter  # {taille_circuit: multiplicité}


# --------------------------------------------------------------------------- #
# Utilitaires de plan
# --------------------------------------------------------------------------- #


def plan_sizes(plan: Plan) -> List[int]:
    """Tailles du plan, en ordre décroissant, avec répétitions."""
    out: List[int] = []
    for k in sorted(plan, reverse=True):
        out.extend([k] * plan[k])
    return out


def plan_m(plan: Plan) -> int:
    """Nombre de preuves du plan."""
    return sum(plan.values())


def plan_capacity(plan: Plan) -> int:
    """Nombre total de slots de transaction ouverts par le plan."""
    return sum(k * c for k, c in plan.items())


def plan_str(plan: Plan) -> str:
    """'1024+32' — forme compacte, tailles décroissantes."""
    parts = []
    for k in sorted(plan, reverse=True):
        c = plan[k]
        parts.append(f"{k}" if c == 1 else f"{c}x{k}")
    return "+".join(parts) if parts else "-"


def parse_plan(spec: str) -> Plan:
    """'1024+16+8+2' ou '2x512+32' -> Counter."""
    plan: Plan = Counter()
    for token in spec.replace(" ", "").split("+"):
        if not token:
            continue
        if "x" in token.lower():
            c, _, k = token.lower().partition("x")
            plan[int(k)] += int(c)
        else:
            plan[int(token)] += 1
    return plan


# --------------------------------------------------------------------------- #
# Modèle de coût
# --------------------------------------------------------------------------- #


@dataclass
class SizeCost:
    """Coûts mesurés pour un circuit d'une taille donnée."""

    size: int
    witness_s: float = 0.0
    prove_s: float = 0.0
    verify_s: float = 0.0
    prove_std_s: float = 0.0
    verify_std_s: float = 0.0
    n_rep: int = 0

    def to_dict(self) -> Dict[str, float]:
        return {
            "witness_s": self.witness_s,
            "prove_s": self.prove_s,
            "verify_s": self.verify_s,
            "prove_std_s": self.prove_std_s,
            "verify_std_s": self.verify_std_s,
            "n_rep": self.n_rep,
        }


@dataclass
class CostModel:
    """Coûts atomiques par prover et par taille de circuit."""

    provers: Dict[str, Dict[int, SizeCost]] = field(default_factory=dict)
    meta: Dict[str, object] = field(default_factory=dict)

    # -- I/O --------------------------------------------------------------- #

    def save(self, path: str) -> None:
        os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
        payload = {
            "meta": self.meta,
            "provers": {
                p: {str(k): c.to_dict() for k, c in sorted(sizes.items())}
                for p, sizes in self.provers.items()
            },
        }
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2, ensure_ascii=False)

    @staticmethod
    def load(path: str) -> "CostModel":
        with open(path, "r", encoding="utf-8") as f:
            payload = json.load(f)
        model = CostModel(meta=payload.get("meta", {}))
        for prover, sizes in payload.get("provers", {}).items():
            model.provers[prover] = {
                int(k): SizeCost(size=int(k), **{kk: vv for kk, vv in v.items()})
                for k, v in sizes.items()
            }
        return model

    # -- accès ------------------------------------------------------------- #

    def sizes(self, prover: str) -> List[int]:
        return sorted(self.provers[prover])

    def available_provers(self) -> List[str]:
        return [p for p in PROVERS if p in self.provers] + [
            p for p in sorted(self.provers) if p not in PROVERS
        ]


@dataclass
class Objective:
    """Fonction de coût additive J(S) = sum c(k_i) + m * alpha."""

    prover: str
    include_witness: bool = True
    include_verify: bool = True
    overhead_s: float = 0.0  # surcoût fixe par preuve, hors vérification
    mode: str = "time"  # time | usd
    usd_per_hour: float = 0.0
    gas_per_proof: float = 0.0
    gas_price_gwei: float = 0.0
    eth_usd: float = 0.0

    @property
    def unit(self) -> str:
        return "s" if self.mode == "time" else "USD"

    def gas_cost_usd(self) -> float:
        return self.gas_per_proof * self.gas_price_gwei * 1e-9 * self.eth_usd

    def seconds(self, cost: SizeCost) -> float:
        """Temps mur imputé à une preuve de cette taille."""
        t = cost.prove_s
        if self.include_witness:
            t += cost.witness_s
        if self.include_verify:
            t += cost.verify_s
        return t + self.overhead_s

    def unit_cost(self, cost: SizeCost) -> float:
        """Coût d'une preuve, dans l'unité de l'objectif."""
        t = self.seconds(cost)
        if self.mode == "usd":
            return t / 3600.0 * self.usd_per_hour + self.gas_cost_usd()
        return t

    def alpha(self, model: CostModel) -> float:
        """Part du coût unitaire indépendante de la taille du circuit.

        Vérification + surcoût de soumission : c'est ce qu'on paie *par preuve*,
        et donc ce qui pénalise les décompositions fines.
        """
        verif = 0.0
        if self.include_verify:
            costs = model.provers[self.prover]
            vals = [c.verify_s for c in costs.values() if c.verify_s > 0]
            verif = statistics.mean(vals) if vals else 0.0
        t = verif + self.overhead_s
        if self.mode == "usd":
            return t / 3600.0 * self.usd_per_hour + self.gas_cost_usd()
        return t


def build_cost_table(model: CostModel, obj: Objective) -> Dict[int, float]:
    """Coût unitaire par taille de circuit, pour l'objectif donné."""
    return {k: obj.unit_cost(c) for k, c in model.provers[obj.prover].items()}


# --------------------------------------------------------------------------- #
# Ajustement affine c(k) = a + b*k
# --------------------------------------------------------------------------- #


@dataclass
class AffineFit:
    a: float  # surcoût fixe de preuve (s)
    b: float  # coût marginal par transaction (s/tx)
    r2: float

    def rho(self, alpha: float) -> float:
        """Prix d'une preuve supplémentaire, en transactions vides."""
        return (self.a + alpha) / self.b if self.b > 0 else float("inf")

    def predict(self, k: float) -> float:
        return self.a + self.b * k


def fit_affine(sizes: Sequence[int], values: Sequence[float]) -> AffineFit:
    """Moindres carrés ordinaires sur c(k) = a + b*k (sans dépendance numpy)."""
    n = len(sizes)
    if n < 2:
        return AffineFit(a=values[0] if values else 0.0, b=0.0, r2=0.0)
    mx = statistics.mean(sizes)
    my = statistics.mean(values)
    sxx = sum((x - mx) ** 2 for x in sizes)
    sxy = sum((x - mx) * (y - my) for x, y in zip(sizes, values))
    b = sxy / sxx if sxx > 0 else 0.0
    a = my - b * mx
    ss_tot = sum((y - my) ** 2 for y in values)
    ss_res = sum((y - (a + b * x)) ** 2 for x, y in zip(sizes, values))
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else 1.0
    return AffineFit(a=a, b=b, r2=r2)


# --------------------------------------------------------------------------- #
# Algorithme : programmation dynamique exacte
# --------------------------------------------------------------------------- #


def solve_dp(nmax: int, cost: Dict[int, float]) -> Tuple[List[float], List[int]]:
    """Optimum pour tout n de 0 à nmax.

    f[n] = coût minimal d'un multi-ensemble de circuits couvrant AU MOINS n
    transactions ; choice[n] = une taille de circuit optimale à utiliser en
    premier. Complexité O(nmax * |K|), mémoire O(nmax).

    Exactitude : J est additive et invariante par permutation, donc pour un
    multi-ensemble optimal S couvrant n, retirer n'importe quel k de S laisse un
    multi-ensemble couvrant au moins n-k, d'où la récurrence avec clamp à 0
    (sur-couvrir est gratuit : c'est exactement le padding).
    """
    sizes = sorted(cost)
    f = [0.0] + [math.inf] * nmax
    choice = [0] * (nmax + 1)
    for n in range(1, nmax + 1):
        best = math.inf
        best_k = 0
        for k in sizes:
            prev = f[n - k] if n > k else 0.0
            cand = cost[k] + prev
            if cand < best:
                best = cand
                best_k = k
        f[n] = best
        choice[n] = best_k
    return f, choice


def reconstruct(n: int, choice: Sequence[int]) -> Plan:
    """Plan optimal pour n, à partir de la table de décisions."""
    plan: Plan = Counter()
    cur = n
    while cur > 0:
        k = choice[cur]
        if k <= 0:  # sécurité : ne devrait pas arriver
            break
        plan[k] += 1
        cur = max(0, cur - k)
    return plan


def k_best_plans(
    n: int,
    cost: Dict[int, float],
    f: Sequence[float],
    k_best: int = 10,
    node_budget: int = 400_000,
) -> List[Tuple[float, Plan]]:
    """Les `k_best` plans les moins chers, par recherche A*.

    L'énumération est canonisée (tailles choisies en ordre décroissant) pour ne
    compter chaque multi-ensemble qu'une seule fois. L'heuristique est la table
    de la DP elle-même : f[reste] est le coût optimal *exact* pour couvrir le
    reste, sans la contrainte de canonisation — c'est donc une minoration
    consistante, et la recherche n'explore presque aucun nœud inutile. Comme
    h = 0 sur les états complets, les plans complets sortent du tas par coût
    croissant : les `k_best` premiers sont exactement les meilleurs.

    La recherche s'arrête dès que la couverture est atteinte : elle énumère donc
    exactement les couvertures *irredondantes* (aucun circuit ne peut être retiré
    sans passer sous N), ce qui est bien l'ensemble des plans à classer — un plan
    avec une preuve inutile en plus est toujours dominé.

    `node_budget` reste une sécurité ; le classement produit demeure correct,
    il peut seulement être incomplet si la borne est atteinte.
    """
    sizes = sorted(cost, reverse=True)

    def h(rest: int) -> float:
        return f[rest] if rest > 0 else 0.0

    # (priorité = coût + heuristique, coût réel, compteur, index max, reste, plan)
    heap: List[Tuple[float, float, int, int, int, Tuple[Tuple[int, int], ...]]] = []
    tie = 0
    heapq.heappush(heap, (h(n), 0.0, tie, 0, n, ()))
    out: List[Tuple[float, Plan]] = []
    pops = 0
    while heap and len(out) < k_best and pops < node_budget:
        _, c, _, idx, rest, items = heapq.heappop(heap)
        pops += 1
        if rest <= 0:
            out.append((c, Counter(dict(items))))
            continue
        for j in range(idx, len(sizes)):
            k = sizes[j]
            new_items = dict(items)
            new_items[k] = new_items.get(k, 0) + 1
            tie += 1
            new_c = c + cost[k]
            new_rest = rest - k
            heapq.heappush(
                heap,
                (
                    new_c + h(max(0, new_rest)),
                    new_c,
                    tie,
                    j,  # non-croissance : on ne revient jamais à une taille plus grande
                    new_rest,
                    tuple(sorted(new_items.items())),
                ),
            )
    return out


# --------------------------------------------------------------------------- #
# Stratégies de référence (baselines)
# --------------------------------------------------------------------------- #


def plan_single(n: int, sizes: Sequence[int]) -> Plan:
    """Un seul circuit, le plus petit qui contienne n, complété par du padding.

    Au-delà de la plus grande taille disponible, on répète cette taille : c'est
    la généralisation naturelle de « une preuve, remplie de vide ».
    """
    for k in sorted(sizes):
        if k >= n:
            return Counter({k: 1})
    kmax = max(sizes)
    return Counter({kmax: math.ceil(n / kmax)})


def plan_binary(n: int, sizes: Sequence[int]) -> Plan:
    """Décomposition gloutonne par tailles décroissantes.

    Sur K = puissances de deux, c'est exactement l'écriture binaire de n (avec
    répétition de la plus grande taille pour la partie haute), c'est-à-dire la
    stratégie « 1024 + 16 + 8 + 2 » de l'énoncé. Le reliquat final est arrondi à
    la plus petite taille disponible qui le couvre.
    """
    plan: Plan = Counter()
    rest = n
    desc = sorted(sizes, reverse=True)
    kmin = min(sizes)
    for k in desc:
        if rest <= 0:
            break
        if k <= rest:
            c = rest // k
            plan[k] += c
            rest -= c * k
    if rest > 0:  # reliquat plus petit que le plus petit circuit
        plan[kmin] += 1
    return plan


def plan_maxrep(n: int, sizes: Sequence[int]) -> Plan:
    """Répétition du plus grand circuit disponible (stratégie « gros batch »)."""
    kmax = max(sizes)
    return Counter({kmax: max(1, math.ceil(n / kmax))})


def plan_cost(plan: Plan, cost: Dict[int, float]) -> float:
    return sum(cost[k] * c for k, c in plan.items())


# --------------------------------------------------------------------------- #
# Mesure des coûts atomiques
# --------------------------------------------------------------------------- #


def discover_sizes(circuits_dir: str) -> List[int]:
    """Tailles de circuit prêtes à l'emploi (zkey + wasm présents)."""
    out: List[int] = []
    if not os.path.isdir(circuits_dir):
        return out
    for entry in sorted(os.listdir(circuits_dir)):
        if not entry.isdigit():
            continue
        d = os.path.join(circuits_dir, entry)
        zkey = os.path.join(d, "circuit_final.zkey")
        wasm = os.path.join(d, "circuit_js", "circuit.wasm")
        if os.path.isfile(zkey) and os.path.isfile(wasm):
            out.append(int(entry))
    return sorted(out)


def _run(cmd: Sequence[str], cwd: str) -> Tuple[int, float]:
    """Exécute une commande, retourne (code retour, durée mur)."""
    t0 = time.perf_counter()
    try:
        proc = subprocess.run(cmd, cwd=cwd, capture_output=True)
        rc = proc.returncode
    except FileNotFoundError:
        rc = 127
    return rc, time.perf_counter() - t0


def _timeit(cmd: Sequence[str], cwd: str, repeat: int, warmup: bool, sleep_s: float,
            label: str) -> Tuple[List[float], bool]:
    """Chronomètre `repeat` exécutions ; retourne (durées, toutes réussies)."""
    ok = True
    if warmup:
        rc, _ = _run(cmd, cwd)
        ok = ok and rc == 0
    times: List[float] = []
    for i in range(repeat):
        rc, dt = _run(cmd, cwd)
        ok = ok and rc == 0
        times.append(dt)
        print(f"      {label}: {dt:8.4f} s  ({i + 1}/{repeat})"
              f"{'' if rc == 0 else f'  [échec rc={rc}]'}")
        if sleep_s > 0:
            time.sleep(sleep_s)
    return times, ok


def measure_costs(args: argparse.Namespace) -> CostModel:
    """Mesure witness / preuve / vérification pour chaque taille disponible."""
    circuits_dir = os.path.abspath(args.circuits_dir)
    sizes = (
        [int(s) for s in args.sizes.split(",")] if args.sizes else discover_sizes(circuits_dir)
    )
    if not sizes:
        raise SystemExit(
            f"aucun circuit exploitable dans {circuits_dir} "
            f"(il faut circuit_final.zkey et circuit_js/circuit.wasm)"
        )

    provers = PROVERS if args.prover == "both" else (args.prover,)
    model = CostModel(
        meta={
            "source": "measure",
            "timestamp": datetime.now().isoformat(timespec="seconds"),
            "host": platform.node(),
            "platform": platform.platform(),
            "user": getpass.getuser(),
            "repeat": args.repeat,
            "warmup": args.warmup,
            "circuits_dir": circuits_dir,
            "sizes": sizes,
        }
    )
    for p in provers:
        model.provers[p] = {}

    for k in sizes:
        print(f"\n[taille {k}]")
        rel = f"./circuits/{k}"
        wtns_cmd = [
            args.snarkjs, "wtns", "calculate",
            f"{rel}/circuit_js/circuit.wasm", f"{rel}/input.json", f"{rel}/witness.wtns",
        ]
        wt, _ = _timeit(wtns_cmd, REPO_ROOT, args.repeat, args.warmup, args.sleep, "witness")

        verify_cmd = [
            args.snarkjs, "groth16", "verify",
            f"{rel}/verification_key.json", f"{rel}/public.json", f"{rel}/proof.json",
        ]

        for p in provers:
            if p == "snarkjs":
                prove_cmd = [
                    args.snarkjs, "groth16", "prove",
                    f"{rel}/circuit_final.zkey", f"{rel}/witness.wtns",
                    f"{rel}/proof.json", f"{rel}/public.json",
                ]
            else:
                base = args.docker_mount_prefix.rstrip("/")
                prove_cmd = [
                    "docker", "exec", args.docker_container, args.docker_prover_path,
                    f"{base}/{k}/circuit_final.zkey", f"{base}/{k}/witness.wtns",
                    f"{base}/{k}/proof.json", f"{base}/{k}/public.json",
                ]
            pt, pok = _timeit(prove_cmd, REPO_ROOT, args.repeat, args.warmup, args.sleep,
                              f"prove/{p}")
            vt, _ = _timeit(verify_cmd, REPO_ROOT, args.repeat, args.warmup, args.sleep,
                            "verify")
            if not pok:
                print(f"      [attention] au moins une exécution de {p} a échoué pour k={k}")
            model.provers[p][k] = SizeCost(
                size=k,
                witness_s=statistics.median(wt) if wt else 0.0,
                prove_s=statistics.median(pt) if pt else 0.0,
                verify_s=statistics.median(vt) if vt else 0.0,
                prove_std_s=statistics.pstdev(pt) if len(pt) > 1 else 0.0,
                verify_std_s=statistics.pstdev(vt) if len(vt) > 1 else 0.0,
                n_rep=args.repeat,
            )
    return model


def import_bench_out(path: str) -> CostModel:
    """Convertit un run de generate_proofs.py (bench-out/<ts>) en modèle de coût.

    Les timings de ce script incluent déjà le calcul du témoin dans la mesure du
    prover : on les impute donc entièrement à `prove_s` et on laisse witness_s à
    zéro, pour ne pas compter deux fois.
    """
    raw = os.path.join(path, "raw") if os.path.isdir(os.path.join(path, "raw")) else path

    def load(name: str) -> List[dict]:
        p = os.path.join(raw, name)
        if not os.path.isfile(p):
            return []
        with open(p, "r", encoding="utf-8") as f:
            return json.load(f)

    files = {
        "rapidsnark": "rapidsnark_timings.json",
        "snarkjs": "snarkjs_timings.json",
    }
    verify_rows = {int(r["n"]): r for r in load("snarkjs_verify_timings.json")}

    model = CostModel(
        meta={
            "source": "import",
            "from": os.path.abspath(path),
            "timestamp": datetime.now().isoformat(timespec="seconds"),
            "note": "prove_s inclut le calcul du témoin (mesure de generate_proofs.py)",
        }
    )
    for prover, fname in files.items():
        rows = load(fname)
        if not rows:
            continue
        model.provers[prover] = {}
        for r in rows:
            n = int(r["n"])
            timings = r.get("timings") or []
            v = verify_rows.get(n, {})
            vt = v.get("timings") or []
            model.provers[prover][n] = SizeCost(
                size=n,
                witness_s=0.0,
                prove_s=float(r.get("mean", 0.0)),
                verify_s=float(v.get("mean", 0.0)),
                prove_std_s=statistics.pstdev(timings) if len(timings) > 1 else 0.0,
                verify_std_s=statistics.pstdev(vt) if len(vt) > 1 else 0.0,
                n_rep=len(timings),
            )
    if not model.provers:
        raise SystemExit(f"aucun fichier de timings exploitable sous {raw}")
    return model


# --------------------------------------------------------------------------- #
# Analyse : balayage, figures, tables
# --------------------------------------------------------------------------- #


def strategy_plans(n: int, sizes: Sequence[int], choice: Sequence[int]) -> Dict[str, Plan]:
    return {
        "opt": reconstruct(n, choice),
        "binary": plan_binary(n, sizes),
        "single": plan_single(n, sizes),
        "maxrep": plan_maxrep(n, sizes),
    }


def sweep(
    nmax: int, cost: Dict[int, float], choice: Sequence[int]
) -> List[Dict[str, object]]:
    """Une ligne par N : coût, nombre de preuves, padding et gains par stratégie."""
    sizes = sorted(cost)
    rows: List[Dict[str, object]] = []
    for n in range(1, nmax + 1):
        plans = strategy_plans(n, sizes, choice)
        row: Dict[str, object] = {"n": n}
        for name, plan in plans.items():
            c = plan_cost(plan, cost)
            cap = plan_capacity(plan)
            row[f"{name}_cost"] = c
            row[f"{name}_proofs"] = plan_m(plan)
            row[f"{name}_padding"] = cap - n
            row[f"{name}_padding_ratio"] = (cap - n) / cap if cap else 0.0
            row[f"{name}_cost_per_tx"] = c / n
        row["opt_plan"] = plan_str(plans["opt"])
        for name in ("binary", "single", "maxrep"):
            base = float(row[f"{name}_cost"])
            row[f"gain_vs_{name}_pct"] = (
                (base - float(row["opt_cost"])) / base * 100.0 if base > 0 else 0.0
            )
        rows.append(row)
    return rows


def write_sweep_csv(path: str, rows: List[Dict[str, object]]) -> None:
    if not rows:
        return
    fields = list(rows[0].keys())
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for r in rows:
            w.writerow(r)


def phase_diagram(
    sizes: Sequence[int], n_grid: Sequence[int], rho_grid: Sequence[float]
) -> Tuple[List[List[int]], List[List[float]]]:
    """Diagramme de phase exact du compromis, en unités de transaction.

    Sous le modèle affine c(k) = a + b*k, minimiser J revient à minimiser
    m*rho + capacité (tout divisé par b), avec rho = (a + alpha)/b. Le coût
    unitaire d'un circuit de taille k vaut donc simplement `rho + k` : le
    diagramme obtenu est indépendant de la machine, et chaque prover s'y place
    par son rho mesuré.

    Retourne (m*, gain relatif de l'optimum sur le circuit unique rempli),
    indexés [ligne = rho, colonne = N].
    """
    nmax = max(n_grid)
    m_mat: List[List[int]] = []
    gain_mat: List[List[float]] = []
    for rho in rho_grid:
        cost = {k: rho + k for k in sizes}
        _, choice = solve_dp(nmax, cost)
        m_row, g_row = [], []
        for n in n_grid:
            plan = reconstruct(n, choice)
            m_row.append(plan_m(plan))
            c_opt = plan_cost(plan, cost)
            c_single = plan_cost(plan_single(n, sizes), cost)
            g_row.append((c_single - c_opt) / c_single * 100.0 if c_single > 0 else 0.0)
        m_mat.append(m_row)
        gain_mat.append(g_row)
    return m_mat, gain_mat


def critical_rho(
    n_grid: Sequence[int], rho_grid: Sequence[float], m_mat: Sequence[Sequence[int]]
) -> List[Optional[float]]:
    """rho*(N) : plus petit rho pour lequel une seule preuve redevient optimale.

    Découper n'est rentable que si rho < rho*(N) : au-delà, la preuve
    supplémentaire coûte plus cher que le padding qu'elle évite.
    """
    out: List[Optional[float]] = []
    for j in range(len(n_grid)):
        val: Optional[float] = None
        for i, rho in enumerate(rho_grid):
            if m_mat[i][j] <= 1:
                val = rho
                break
        out.append(val)
    return out


# --------------------------------------------------------------------------- #
# Figures
# --------------------------------------------------------------------------- #


@dataclass
class FigureStyle:
    """Paramètres d'export des figures, pensés pour l'insertion dans un article.

    `width_in` est la largeur *finale* de la figure dans le document : on
    dessine à la taille de publication plutôt que de réduire après coup, pour
    que la taille de police du graphique soit exactement celle demandée
    (typiquement 8–9 pt pour une colonne de 3.5 pouces).
    """

    formats: Tuple[str, ...] = ("png", "pdf")
    dpi: int = 600
    width_in: float = SINGLE_COLUMN_IN
    font_size: float = 8.0
    titles: bool = False  # dans un article, le titre est la légende (caption)


FIG = FigureStyle()

# outdir -> [(nom de figure, légende)], vidé en fin d'analyse dans figures.tex
_CAPTIONS: Dict[str, List[Tuple[str, str]]] = {}


def _figsize(ratio: float = 0.66, span: float = 1.0) -> Tuple[float, float]:
    """(largeur, hauteur) en pouces ; `span` = multiple de la largeur de base."""
    w = FIG.width_in * span
    return (w, w * ratio)


def _setup_mpl():
    """rcParams de qualité publication (vecteur, polices à empattement, ticks internes)."""
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    try:
        import scienceplots  # noqa: F401  (enregistre le style "science")

        plt.style.use(["science"])
    except Exception:
        plt.style.use("default")

    s = FIG.font_size
    matplotlib.rcParams.update({
        # Polices : serif pour s'accorder au corps de texte d'un article, et
        # mathtext STIX pour que $N$, $\rho$, $m^*$ aient le même dessin que
        # dans le LaTeX environnant. usetex reste désactivé : le script doit
        # tourner sans distribution TeX installée.
        "text.usetex": False,
        "mathtext.fontset": "stix",
        "font.family": "serif",
        "font.serif": ["Times New Roman", "Nimbus Roman", "STIXGeneral",
                       "DejaVu Serif"],
        "font.size": s,
        "axes.titlesize": s + 1,
        "axes.labelsize": s,
        "xtick.labelsize": s - 1,
        "ytick.labelsize": s - 1,
        "legend.fontsize": s - 1,
        "figure.titlesize": s + 1,
        # Cadre et graduations
        "axes.linewidth": 0.6,
        "axes.grid": False,
        "grid.color": "#B0B0B0",
        "grid.linewidth": 0.35,
        "grid.alpha": 0.6,
        "xtick.direction": "in",
        "ytick.direction": "in",
        "xtick.top": True,
        "ytick.right": True,
        "xtick.minor.visible": True,
        "ytick.minor.visible": True,
        "xtick.major.width": 0.6,
        "ytick.major.width": 0.6,
        "xtick.minor.width": 0.4,
        "ytick.minor.width": 0.4,
        "xtick.major.size": 3.0,
        "ytick.major.size": 3.0,
        "xtick.minor.size": 1.6,
        "ytick.minor.size": 1.6,
        # Traits et légende
        "lines.linewidth": 1.0,
        "lines.markersize": 3.0,
        "legend.frameon": True,
        "legend.framealpha": 0.92,
        "legend.edgecolor": "0.8",
        "legend.fancybox": False,
        "legend.borderpad": 0.35,
        "legend.handlelength": 2.2,
        "legend.labelspacing": 0.3,
        "legend.borderaxespad": 0.4,
        # Export : polices vectorielles éditables dans le PDF/SVG (type 42),
        # texte non converti en courbes, marges serrées.
        "figure.dpi": 150,
        "savefig.dpi": FIG.dpi,
        "savefig.bbox": "tight",
        "savefig.pad_inches": 0.02,
        "savefig.transparent": False,
        "pdf.fonttype": 42,
        "ps.fonttype": 42,
        "svg.fonttype": "none",
        "pdf.compression": 6,
        "agg.path.chunksize": 10_000,
    })
    return plt


def _finish(ax, legend: bool = True, title: str = "", **legend_kw) -> None:
    """Grille, légende et titre optionnel, de façon homogène sur toutes les figures."""
    ax.grid(True, which="major", ls="--", lw=0.35, alpha=0.6)
    ax.grid(True, which="minor", ls=":", lw=0.25, alpha=0.35)
    ax.set_axisbelow(True)
    if legend:
        ax.legend(**legend_kw)
    if title and FIG.titles:
        ax.set_title(title)


def _ordered_handles(ax):
    """Entrées de légende remises dans l'ordre logique des stratégies."""
    handles, labels = ax.get_legend_handles_labels()
    wanted = [STRATEGY_LABELS[s] for s in STRATEGIES]
    order = sorted(range(len(labels)),
                   key=lambda i: wanted.index(labels[i]) if labels[i] in wanted else 99)
    return [handles[i] for i in order], [labels[i] for i in order]


def _legend_strategies(ax, **kw) -> None:
    """Légende dans l'ordre logique des stratégies, quel que soit l'ordre de tracé."""
    ax.legend(*_ordered_handles(ax), **kw)


def _legend_above(ax, ncol: int = 2) -> None:
    """Légende commune posée juste au-dessus du panneau, hors zone de données.

    Sur une figure multi-panneaux, une légende interne recouvre les courbes quelle
    que soit sa position : elle sort donc du cadre (ancrée aux coordonnées de
    l'axe, pour rester collée à lui), et `bbox_inches=tight` la réintègre à
    l'export.
    """
    handles, labels = _ordered_handles(ax)
    ax.legend(handles, labels, loc="lower center", bbox_to_anchor=(0.5, 1.01),
              ncol=ncol, frameon=False, borderaxespad=0.0,
              columnspacing=1.4, handletextpad=0.6)


def _save(plt, fig, outdir: str, name: str, caption: str = "") -> None:
    """Écrit la figure dans tous les formats demandés et mémorise sa légende."""
    for ext in FIG.formats:
        fig.savefig(os.path.join(outdir, f"{name}.{ext}"), dpi=FIG.dpi)
    plt.close(fig)
    if caption:
        _CAPTIONS.setdefault(outdir, []).append((name, caption))
    print(f"    figure : {name}." + "/.".join(FIG.formats))


def _tex_escape(text: str) -> str:
    """Le texte des légendes est du français courant : on protège %, _, &, #."""
    for ch in ("\\", "%", "_", "&", "#"):
        text = text.replace(ch, "\\" + ch) if ch != "\\" else text
    return text


def flush_captions() -> None:
    """Écrit un figures.tex prêt à \\input dans le manuscrit, un bloc par figure.

    Les figures sont exportées sans titre (cf. FigureStyle.titles) : c'est la
    légende qui porte l'information, comme le veut l'usage éditorial.
    """
    for outdir, entries in sorted(_CAPTIONS.items()):
        path = os.path.join(outdir, "figures.tex")
        lines = [
            "% généré par scripts/optimize_batch_partition.py",
            "% \\usepackage{graphicx} ; \\graphicspath{{" +
            os.path.basename(outdir.rstrip(os.sep)) + "/}}",
            "",
        ]
        for name, caption in entries:
            lines += [
                "\\begin{figure}[t]",
                "  \\centering",
                f"  \\includegraphics[width=\\linewidth]{{{name}}}",
                f"  \\caption{{{_tex_escape(caption)}}}",
                f"  \\label{{fig:{name.replace('_', '-')}}}",
                "\\end{figure}",
                "",
            ]
        with open(path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        print(f"    légendes LaTeX : {os.path.basename(path)} ({outdir})")
    _CAPTIONS.clear()


def _moving_average(xs: Sequence[float], window: int) -> List[float]:
    if window <= 1:
        return list(xs)
    out, acc = [], 0.0
    from collections import deque

    buf: deque = deque()
    for x in xs:
        buf.append(x)
        acc += x
        if len(buf) > window:
            acc -= buf.popleft()
        out.append(acc / len(buf))
    return out


def make_figures(
    outdir: str,
    rows: List[Dict[str, object]],
    model: CostModel,
    obj: Objective,
    fit: AffineFit,
    zoom: Tuple[int, int],
) -> None:
    plt = _setup_mpl()
    unit = obj.unit
    ns = [int(r["n"]) for r in rows]

    def curve(ax, xs, ys, s, **kw):
        return ax.plot(xs, ys, color=STRATEGY_COLORS[s], ls=STRATEGY_LINESTYLES[s],
                       label=STRATEGY_LABELS[s],
                       zorder=2 + DRAW_ORDER.index(s), **kw)

    # --- 1. coût total par stratégie -------------------------------------- #
    fig, ax = plt.subplots(figsize=_figsize(0.72))
    for s in DRAW_ORDER:
        curve(ax, ns, [r[f"{s}_cost"] for r in rows], s, lw=0.9)
    ax.set_xlabel(r"Batch size $N$ (transactions)")
    ax.set_ylabel(f"Total settlement cost ({unit})")
    ax.set_xscale("log")
    ax.set_yscale("log")
    _finish(ax, legend=False,
            title=f"Cost of proving $N$ transactions ({obj.prover})")
    _legend_strategies(ax, loc="upper left")
    _save(plt, fig, outdir, "01_cost_vs_n",
          f"Total cost of settling a batch of $N$ transactions with the {obj.prover} "
          f"prover, for the exact optimum and three standard heuristics. Both axes are "
          f"logarithmic; the cost model is the one measured in "
          f"Fig.~\\ref{{fig:07-cost-model-fit}}.")

    # --- 2. gain relatif de l'optimum ------------------------------------- #
    fig, ax = plt.subplots(figsize=_figsize(0.72))
    for s in ("single", "binary", "maxrep"):
        g = [float(r[f"gain_vs_{s}_pct"]) for r in rows]
        ax.plot(ns, g, lw=0.25, alpha=0.3, color=STRATEGY_COLORS[s], zorder=1)
        ax.plot(ns, _moving_average(g, 101), lw=1.1, color=STRATEGY_COLORS[s],
                ls=STRATEGY_LINESTYLES[s], zorder=2, label=f"vs. {STRATEGY_LABELS[s]}")
    ax.set_xlabel(r"Batch size $N$ (transactions)")
    ax.set_ylabel("Cost reduction of the optimum (%)")
    ax.set_xscale("log")
    ax.set_ylim(bottom=0)
    _finish(ax, title="How much the optimal partition saves", loc="upper right")
    _save(plt, fig, outdir, "02_relative_gain",
          "Relative cost reduction of the optimal partition over each heuristic. "
          "Faint lines are the raw per-$N$ values, solid lines a 101-point moving "
          "average; the sawtooth spread is intrinsic to the discrete set of circuit "
          "sizes, not measurement noise.")

    # --- 2b. zoom : structure en dents de scie ---------------------------- #
    lo, hi = zoom
    sub = [r for r in rows if lo <= int(r["n"]) <= hi]
    if len(sub) > 1:
        fig, ax = plt.subplots(figsize=_figsize(0.72))
        zns = [int(r["n"]) for r in sub]
        for s in DRAW_ORDER:
            curve(ax, zns, [r[f"{s}_cost"] for r in sub], s, lw=1.0)
        ax.set_xlabel(r"Batch size $N$ (transactions)")
        ax.set_ylabel(f"Total settlement cost ({unit})")
        _finish(ax, legend=False, title=f"Sawtooth structure of the padding penalty "
                          f"($N \\in [{lo}, {hi}]$)")
        _legend_strategies(ax, loc="best")
        _save(plt, fig, outdir, "02b_zoom_sawtooth",
              f"Detail of the padding penalty for $N \\in [{lo}, {hi}]$. The single "
              f"padded circuit is flat until the next circuit size is reached, while "
              f"the optimal partition follows $N$ almost continuously.")

    # --- 3. padding et nombre de preuves ---------------------------------- #
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=_figsize(1.15), sharex=True)
    for s in DRAW_ORDER:
        curve(ax1, ns, [float(r[f"{s}_padding_ratio"]) * 100 for r in rows], s, lw=0.8)
        ax2.plot(ns, [int(r[f"{s}_proofs"]) for r in rows], lw=0.8,
                 color=STRATEGY_COLORS[s], ls=STRATEGY_LINESTYLES[s],
                 zorder=2 + DRAW_ORDER.index(s))
    ax1.set_ylabel("Padding (% of proven slots)")
    ax1.set_ylim(bottom=0)
    _finish(ax1, legend=False, title="The two costs the optimum trades off")
    ax2.set_ylabel(r"Number of proofs $m$")
    ax2.set_xlabel(r"Batch size $N$ (transactions)")
    ax2.set_xscale("log")
    ax2.set_yscale("log")
    _finish(ax2, legend=False)
    for ax, tag in ((ax1, "(a)"), (ax2, "(b)")):
        ax.text(0.012, 0.94, tag, transform=ax.transAxes, va="top", ha="left",
                fontsize=FIG.font_size)
    fig.align_ylabels((ax1, ax2))
    fig.subplots_adjust(hspace=0.08)
    _legend_above(ax1, ncol=2)
    _save(plt, fig, outdir, "03_padding_and_proofs",
          "The two quantities the optimum trades off: (a) the fraction of proven "
          "slots wasted on empty transactions, and (b) the number of proofs, which "
          "sets the per-proof overhead paid. Lowering one raises the other.")

    # --- 4. coût amorti par transaction ----------------------------------- #
    fig, ax = plt.subplots(figsize=_figsize(0.72))
    for s in DRAW_ORDER:
        curve(ax, ns, [float(r[f"{s}_cost_per_tx"]) for r in rows], s, lw=0.9)
    ax.set_xlabel(r"Batch size $N$ (transactions)")
    ax.set_ylabel(f"Amortized cost per transaction ({unit}/tx)")
    ax.set_xscale("log")
    ax.set_yscale("log")
    _finish(ax, legend=False, title="Amortized cost per transaction")
    _legend_strategies(ax, loc="upper right")
    _save(plt, fig, outdir, "04_cost_per_tx",
          f"Cost amortized over the $N$ transactions actually settled "
          f"({unit} per transaction, {obj.prover} prover). The optimal partition "
          f"removes the sawtooth that padding imposes on the other strategies.")

    # --- 7. modèle de coût mesuré et ajustement affine -------------------- #
    costs = model.provers[obj.prover]
    ks = sorted(costs)
    ys = [obj.seconds(costs[k]) for k in ks]
    errs = [costs[k].prove_std_s for k in ks]
    n_rep = max((costs[k].n_rep for k in ks), default=0)
    fig, ax = plt.subplots(figsize=_figsize(0.72))
    eb = ax.errorbar(ks, ys, yerr=errs, fmt="o", ms=3.2, lw=0, elinewidth=0.8, capsize=2,
                capthick=0.8, color=ACCENT, ecolor=ACCENT, zorder=3,
                label="Measured proof cost" + (f" ($n={n_rep}$)" if n_rep else ""))
    grid = [ks[0] + i * (ks[-1] - ks[0]) / 200 for i in range(201)]
    (ln,) = ax.plot(grid, [fit.predict(x) for x in grid], ls="--", lw=1.0,
            color=ACCENT_ALT, zorder=2,
            label=(f"$a + bk$, $a$={fit.a:.3g} s, "
                   f"$b$={fit.b * 1e3:.3g} ms/tx, $R^2$={fit.r2:.4f}"))
    ax.set_xscale("log", base=2)
    ax.set_yscale("log")
    ax.set_xlabel(r"Circuit size $k$ (transactions)")
    ax.set_ylabel("Cost of one proof (s)")
    _finish(ax, legend=False, title=f"Atomic cost model ({obj.prover})")
    ax.legend([eb, ln], [eb.get_label(), ln.get_label()], loc="upper left")
    _save(plt, fig, outdir, "07_cost_model_fit",
          f"Measured cost of a single proof as a function of circuit size $k$ "
          f"({obj.prover}; error bars are one standard deviation over "
          f"{n_rep if n_rep else 'the'} repetitions), with the least-squares affine "
          f"model $c(k) = a + bk$ used throughout the analysis. The fixed part $a$ "
          f"and the marginal part $b$ are what make partitioning a non-trivial "
          f"trade-off.")


def make_phase_figures(
    outdir: str,
    sizes: Sequence[int],
    measured_rho: Dict[str, float],
    highlight: str,
    nmax: int,
    n_points: int = 90,
    rho_points: int = 70,
) -> Dict[str, object]:
    """Diagramme de phase m*(N, rho), gain associé et seuil critique rho*(N).

    Ces figures sont machine-indépendantes : elles décrivent la loi générale du
    compromis « une preuve de plus » contre « du padding en plus », et chaque
    prover mesuré s'y positionne par son rho.
    """
    plt = _setup_mpl()
    import matplotlib.colors as mcolors
    import matplotlib.patheffects as pe

    n_grid = sorted({max(1, round(10 ** (i / (n_points - 1) * math.log10(nmax))))
                     for i in range(n_points)})
    rho_grid = [10 ** (i / (rho_points - 1) * 4.0) for i in range(rho_points)]  # 1 -> 1e4

    m_mat, gain_mat = phase_diagram(sizes, n_grid, rho_grid)
    crit = critical_rho(n_grid, rho_grid, m_mat)

    def mark(ax):
        """Position des provers mesurés, en trait blanc lisible sur les deux cartes."""
        halo = [pe.withStroke(linewidth=1.6, foreground="black", alpha=0.55)]
        for p, r in sorted(measured_rho.items(), key=lambda t: t[1]):
            line = ax.axhline(r, color="w", ls="-" if p == highlight else "--",
                              lw=1.0, zorder=4)
            line.set_path_effects(halo)
            ax.text(n_grid[1], r * 1.15, f"{p}: $\\rho = {r:.0f}$ tx", color="w",
                    fontsize=FIG.font_size - 1.5, zorder=5, path_effects=halo)

    def decorate(ax):
        ax.set_xscale("log")
        ax.set_yscale("log")
        ax.set_xlabel(r"Batch size $N$ (transactions)")
        ax.tick_params(which="both", color="w")
        for spine in ax.spines.values():
            spine.set_linewidth(0.6)

    # --- m*(N, rho) ------------------------------------------------------- #
    fig, ax = plt.subplots(figsize=_figsize(0.74))
    vmax = max(1, max(max(r) for r in m_mat))
    # m* est un entier : on discrétise la colormap sur les valeurs atteintes
    # plutôt que d'afficher une échelle continue et ses graduations 6x10^0.
    if vmax <= 12:
        levels = list(range(1, vmax + 2))
        cmap = plt.get_cmap("viridis", vmax)
        norm = mcolors.BoundaryNorm([lv - 0.5 for lv in levels], cmap.N)
        cb_kw = {"ticks": list(range(1, vmax + 1))}
    else:
        cmap, norm = plt.get_cmap("viridis"), mcolors.LogNorm(vmin=1, vmax=vmax)
        cb_kw = {}
    mesh = ax.pcolormesh(n_grid, rho_grid, m_mat, norm=norm,
                         cmap=cmap, shading="nearest", rasterized=True)
    decorate(ax)
    ax.set_ylabel(r"Per-proof overhead $\rho = (a+\alpha)/b$ (tx-equiv.)")
    if FIG.titles:
        ax.set_title(r"Optimal number of proofs $m^*(N, \rho)$")
    mark(ax)
    cb = fig.colorbar(mesh, ax=ax, pad=0.02, **cb_kw)
    cb.set_label(r"$m^*$ (number of proofs)", fontsize=FIG.font_size)
    cb.outline.set_linewidth(0.6)
    _save(plt, fig, outdir, "05_phase_diagram",
          r"Phase diagram of the optimal number of proofs $m^*$ as a function of the "
          r"batch size $N$ and of the per-proof overhead $\rho = (a+\alpha)/b$, "
          r"expressed in empty-transaction equivalents. The diagram is "
          r"machine-independent: a given prover enters it only through its measured "
          r"$\rho$ (horizontal lines).")

    # --- gain de l'optimum sur le circuit unique rempli -------------------- #
    fig, ax = plt.subplots(figsize=_figsize(0.74))
    mesh = ax.pcolormesh(n_grid, rho_grid, gain_mat, cmap="magma",
                         vmin=0, vmax=max(1e-9, max(max(r) for r in gain_mat)),
                         shading="nearest", rasterized=True)
    decorate(ax)
    ax.set_ylabel(r"Per-proof overhead $\rho$ (tx-equiv.)")
    if FIG.titles:
        ax.set_title("Cost saved by partitioning instead of padding one circuit")
    mark(ax)
    cb = fig.colorbar(mesh, ax=ax, pad=0.02)
    cb.set_label("Cost reduction (%)", fontsize=FIG.font_size)
    cb.outline.set_linewidth(0.6)
    _save(plt, fig, outdir, "06_gain_phase",
          r"Cost saved by the optimal partition over a single padded circuit, over "
          r"the same $(N, \rho)$ plane. The saving vanishes when $\rho$ grows: once a "
          r"proof costs more than the padding it removes, one padded circuit is "
          r"optimal.")

    # --- seuil critique rho*(N) ------------------------------------------- #
    xs = [n for n, c in zip(n_grid, crit) if c is not None]
    ys = [c for c in crit if c is not None]
    if xs:
        fig, ax = plt.subplots(figsize=_figsize(0.72))
        ax.step(xs, ys, where="post", lw=1.2, color=ACCENT,
                label=r"$\rho^*(N)$")
        ax.fill_between(xs, ys, 1.0, step="post", alpha=0.12, color=ACCENT, lw=0)
        # Les deux régimes sont nommés dans la zone qu'ils désignent ; les provers
        # mesurés sont étiquetés à droite pour ne pas recouvrir la courbe.
        # Liseré blanc : les étiquettes restent lisibles là où elles croisent
        # la courbe en escalier ou les traits des provers.
        halo_w = [pe.withStroke(linewidth=2.0, foreground="white")]
        ax.text(0.5, 0.10, "partitioning pays", fontsize=FIG.font_size - 1,
                color=ACCENT, transform=ax.transAxes, ha="center",
                zorder=6, path_effects=halo_w)
        ax.text(0.04, 0.95, "padding one circuit pays", fontsize=FIG.font_size - 1,
                color="0.25", transform=ax.transAxes, va="top",
                zorder=6, path_effects=halo_w)
        for p, r in sorted(measured_rho.items(), key=lambda t: t[1]):
            ax.axhline(r, ls="--", lw=0.9, color=ACCENT_ALT)
            ax.text(xs[-1], r * 1.08, f"{p} ($\\rho={r:.0f}$)", ha="right",
                    fontsize=FIG.font_size - 1.5, color=ACCENT_ALT,
                    zorder=6, path_effects=halo_w)
        ax.set_xscale("log")
        ax.set_yscale("log")
        ax.set_xlabel(r"Batch size $N$ (transactions)")
        ax.set_ylabel(r"Critical overhead $\rho^*(N)$ (tx-equiv.)")
        _finish(ax, legend=False,
                title="When is it worth splitting a batch into several proofs?")
        _save(plt, fig, outdir, "06b_critical_rho",
              r"Critical per-proof overhead $\rho^*(N)$: the largest overhead for "
              r"which splitting a batch of $N$ transactions still beats padding a "
              r"single circuit. Below the curve partitioning pays, above it a single "
              r"padded proof is optimal; dashed lines give the measured provers.")

    return {
        "n_grid": n_grid,
        "rho_grid_tx": rho_grid,
        "critical_rho_tx": {n: c for n, c in zip(n_grid, crit)},
        "measured_rho_tx": measured_rho,
    }


# --------------------------------------------------------------------------- #
# Table LaTeX
# --------------------------------------------------------------------------- #


def _tex_plan(plan: str) -> str:
    return plan.replace("x", "$\\times$")


def latex_table(
    path: str,
    rows: List[Dict[str, object]],
    targets: Sequence[int],
    obj: Objective,
    sizes: Sequence[int],
) -> None:
    by_n = {int(r["n"]): r for r in rows}
    unit = "s" if obj.mode == "time" else "USD"
    lines = [
        "% généré par scripts/optimize_batch_partition.py",
        "\\begin{table}[t]",
        "  \\centering",
        "  \\caption{Optimal batch partition versus common heuristics "
        f"({obj.prover} prover). $m$ is the number of proofs, "
        "\\emph{pad} the number of empty transactions.}",
        "  \\label{tab:zk_partition}",
        "  \\begin{tabular}{r rrr rrr rrr r}",
        "    \\toprule",
        "    & \\multicolumn{3}{c}{Optimal partition} & "
        "\\multicolumn{3}{c}{Single padded circuit} & "
        "\\multicolumn{3}{c}{Binary decomposition} & \\\\",
        "    \\cmidrule(lr){2-4}\\cmidrule(lr){5-7}\\cmidrule(lr){8-10}",
        f"    $N$ & plan & $m$ & cost ({unit}) & plan & pad & cost ({unit}) "
        f"& $m$ & pad & cost ({unit}) & gain \\\\",
        "    \\midrule",
    ]
    for n in targets:
        r = by_n.get(n)
        if r is None:
            continue
        gain = float(r["gain_vs_single_pct"])
        lines.append(
            "    {n} & \\texttt{{{plan}}} & {m} & {c:.3f} & \\texttt{{{kplan}}} & {padS} "
            "& {cS:.3f} & {mB} & {padB} & {cB:.3f} & {g:+.1f}\\% \\\\".format(
                n=n,
                plan=_tex_plan(str(r["opt_plan"])),
                m=r["opt_proofs"],
                c=float(r["opt_cost"]),
                kplan=_tex_plan(plan_str(plan_single(n, sizes))),
                padS=r["single_padding"],
                cS=float(r["single_cost"]),
                mB=r["binary_proofs"],
                padB=r["binary_padding"],
                cB=float(r["binary_cost"]),
                g=gain,
            )
        )
    lines += ["    \\bottomrule", "  \\end{tabular}", "\\end{table}", ""]
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    print(f"    table LaTeX : {os.path.basename(path)}")


# --------------------------------------------------------------------------- #
# Sous-commandes
# --------------------------------------------------------------------------- #


def objective_from_args(args: argparse.Namespace, prover: str) -> Objective:
    return Objective(
        prover=prover,
        include_witness=not args.no_witness,
        include_verify=not args.no_verify,
        overhead_s=args.overhead_per_proof,
        mode=args.objective,
        usd_per_hour=args.usd_per_hour,
        gas_per_proof=args.gas_per_proof,
        gas_price_gwei=args.gas_price_gwei,
        eth_usd=args.eth_usd,
    )


def report_model(model: CostModel, obj: Objective, fit: AffineFit) -> None:
    costs = model.provers[obj.prover]
    alpha = obj.alpha(model)
    print(f"\n=== Modèle de coût — {obj.prover} ===")
    print(f"  tailles disponibles : {sorted(costs)}")
    print(f"  c(k) = a + b*k  ->  a = {fit.a:.4f} s (fixe/preuve), "
          f"b = {fit.b * 1e3:.4f} ms/tx (marginal), R2 = {fit.r2:.4f}")
    print(f"  surcoût par preuve alpha = {alpha:.4f} {obj.unit} "
          f"(vérification {'incluse' if obj.include_verify else 'exclue'}"
          f"{f', + {obj.overhead_s:.4f} s imposés' if obj.overhead_s else ''})")
    rho = fit.rho(alpha)
    print(f"  => rho = (a + alpha)/b = {rho:.1f} transactions")
    print(f"     une preuve de plus coûte autant que {rho:.0f} transactions vides ;")
    print(f"     découper n'est rentable que si cela évite plus de padding que ça.")


def print_plan_ranking(n: int, ranked: List[Tuple[float, Plan, str]], unit: str) -> None:
    best = ranked[0][0] if ranked else 0.0
    print(f"\n{'plan':<34} {'m':>3} {'capacité':>9} {'padding':>8} "
          f"{'coût (' + unit + ')':>14} {'écart':>8}")
    print("-" * 82)
    for c, plan, tag in ranked:
        cap = plan_capacity(plan)
        delta = (c - best) / best * 100.0 if best > 0 else 0.0
        label = plan_str(plan)
        if len(label) > 32:
            label = label[:29] + "..."
        print(f"{label:<34} {plan_m(plan):>3} {cap:>9} {cap - n:>8} "
              f"{c:>14.4f} {delta:>+7.2f}%{'   <- ' + tag if tag else ''}")


def cmd_measure(args: argparse.Namespace) -> None:
    model = measure_costs(args)
    model.save(args.out)
    print(f"\n>>> modèle de coût écrit dans {args.out}")


def cmd_import(args: argparse.Namespace) -> None:
    model = import_bench_out(getattr(args, "from"))
    model.save(args.out)
    for p in model.available_provers():
        print(f"  {p:<12} {len(model.provers[p])} tailles : {model.sizes(p)}")
    print(f"\n>>> modèle de coût écrit dans {args.out}")


def configure_figures(args: argparse.Namespace) -> None:
    """Applique les options d'export de figures passées en ligne de commande."""
    global FIG
    width = {"single": SINGLE_COLUMN_IN, "double": DOUBLE_COLUMN_IN}.get(
        args.fig_width, None
    )
    if width is None:  # largeur explicite en pouces
        width = float(args.fig_width)
    FIG = FigureStyle(
        formats=tuple(dict.fromkeys(args.fig_format)),
        dpi=args.fig_dpi,
        width_in=width,
        font_size=args.fig_font_size,
        titles=args.fig_titles,
    )


def cmd_analyze(args: argparse.Namespace) -> None:
    configure_figures(args)
    model = CostModel.load(args.costs)
    provers = model.available_provers() if args.prover == "both" else [args.prover]
    os.makedirs(args.outdir, exist_ok=True)
    summary: Dict[str, object] = {
        "generated": datetime.now().isoformat(timespec="seconds"),
        "costs_file": os.path.abspath(args.costs),
        "nmax": args.nmax,
        "objective": args.objective,
        "provers": {},
    }
    measured_rho: Dict[str, float] = {}
    all_sizes: List[int] = []

    for prover in provers:
        if prover not in model.provers:
            print(f"[attention] prover {prover} absent du modèle, ignoré")
            continue
        obj = objective_from_args(args, prover)
        cost = build_cost_table(model, obj)
        sizes = sorted(cost)
        raw = model.provers[prover]
        fit = fit_affine(sizes, [obj.seconds(raw[k]) for k in sizes])
        report_model(model, obj, fit)

        print(f"\n[{prover}] programmation dynamique jusqu'à N = {args.nmax}...")
        t0 = time.perf_counter()
        _, choice = solve_dp(args.nmax, cost)
        rows = sweep(args.nmax, cost, choice)
        print(f"  {time.perf_counter() - t0:.2f} s")

        sub = os.path.join(args.outdir, prover)
        os.makedirs(sub, exist_ok=True)
        write_sweep_csv(os.path.join(sub, "partition_sweep.csv"), rows)
        print(f"    balayage : partition_sweep.csv ({len(rows)} lignes)")

        targets = [t for t in args.table_n if 1 <= t <= args.nmax]
        latex_table(os.path.join(sub, "tab_partition.tex"), rows, targets, obj, sizes)

        if not args.no_figures:
            make_figures(sub, rows, model, obj, fit, tuple(args.zoom))

        gains_single = [float(r["gain_vs_single_pct"]) for r in rows]
        gains_binary = [float(r["gain_vs_binary_pct"]) for r in rows]
        n_best_single = sum(1 for r in rows
                            if math.isclose(float(r["opt_cost"]), float(r["single_cost"]),
                                            rel_tol=1e-12))
        n_best_binary = sum(1 for r in rows
                            if math.isclose(float(r["opt_cost"]), float(r["binary_cost"]),
                                            rel_tol=1e-12))
        stats = {
            "sizes": sizes,
            "fit": {"a_s": fit.a, "b_s_per_tx": fit.b, "r2": fit.r2},
            "alpha": obj.alpha(model),
            "rho_tx": fit.rho(obj.alpha(model)),
            "gain_vs_single_pct": {
                "mean": statistics.mean(gains_single),
                "median": statistics.median(gains_single),
                "max": max(gains_single),
            },
            "gain_vs_binary_pct": {
                "mean": statistics.mean(gains_binary),
                "median": statistics.median(gains_binary),
                "max": max(gains_binary),
            },
            "n_where_single_is_optimal": n_best_single,
            "n_where_binary_is_optimal": n_best_binary,
        }
        summary["provers"][prover] = stats
        measured_rho[prover] = fit.rho(obj.alpha(model))
        all_sizes = sizes

        print(f"\n  gain moyen de l'optimum vs circuit unique rempli : "
              f"{stats['gain_vs_single_pct']['mean']:.2f}% "
              f"(max {stats['gain_vs_single_pct']['max']:.2f}%)")
        print(f"  gain moyen vs décomposition binaire            : "
              f"{stats['gain_vs_binary_pct']['mean']:.2f}% "
              f"(max {stats['gain_vs_binary_pct']['max']:.2f}%)")
        print(f"  le circuit unique rempli est optimal pour {n_best_single}/{len(rows)} "
              f"valeurs de N ; la décomposition binaire pour {n_best_binary}/{len(rows)}")

        for n in targets:
            r = next((x for x in rows if int(x["n"]) == n), None)
            if r:
                print(f"    N={n:<6} optimum = {r['opt_plan']:<28} "
                      f"({float(r['opt_cost']):.3f} {obj.unit}, {r['opt_proofs']} preuves, "
                      f"padding {r['opt_padding']}) ; "
                      f"gain {float(r['gain_vs_single_pct']):+.1f}% vs 1 circuit rempli, "
                      f"{float(r['gain_vs_binary_pct']):+.1f}% vs binaire")

    # Le diagramme de phase ne dépend pas de la machine : il décrit la loi
    # générale du compromis, chaque prover mesuré s'y plaçant par son rho.
    if all_sizes and not args.no_figures:
        print("\n[loi générale] diagramme de phase en tx-équivalents...")
        highlight = provers[0] if provers else ""
        summary["phase"] = make_phase_figures(
            args.outdir, all_sizes, measured_rho, highlight, args.nmax
        )

    if not args.no_figures:
        flush_captions()

    with open(os.path.join(args.outdir, "summary.json"), "w", encoding="utf-8") as f:
        json.dump(summary, f, indent=2, ensure_ascii=False, default=str)
    print(f"\n>>> résultats dans {os.path.abspath(args.outdir)}")


def cmd_explain(args: argparse.Namespace) -> None:
    model = CostModel.load(args.costs)
    provers = model.available_provers() if args.prover == "both" else [args.prover]
    for prover in provers:
        if prover not in model.provers:
            continue
        obj = objective_from_args(args, prover)
        cost = build_cost_table(model, obj)
        sizes = sorted(cost)
        raw = model.provers[prover]
        fit = fit_affine(sizes, [obj.seconds(raw[k]) for k in sizes])
        report_model(model, obj, fit)

        n = args.n
        f, choice = solve_dp(n, cost)
        opt = reconstruct(n, choice)

        seen: Dict[str, Tuple[float, Plan, str]] = {}

        def add(plan: Plan, tag: str) -> None:
            key = plan_str(plan)
            c = plan_cost(plan, cost)
            if key not in seen or tag:
                seen[key] = (c, plan, tag if key not in seen else seen[key][2] or tag)

        for c, plan in k_best_plans(n, cost, f, args.top, args.node_budget):
            add(plan, "")
        add(opt, "optimum (DP)")
        add(plan_single(n, sizes), "circuit unique rempli")
        add(plan_binary(n, sizes), "décomposition binaire")
        add(plan_maxrep(n, sizes), "plus grand circuit répété")
        for spec in args.compare or []:
            plan = parse_plan(spec)
            missing = [k for k in plan if k not in cost]
            if missing:
                print(f"[attention] tailles non mesurées ignorées dans '{spec}' : {missing}")
                continue
            if plan_capacity(plan) < n:
                print(f"[attention] '{spec}' ne couvre que {plan_capacity(plan)} < {n} tx")
            add(plan, "imposé")

        ranked = sorted(seen.values(), key=lambda t: t[0])
        print(f"\n=== N = {n} — {prover} — objectif « {obj.mode} » ===")
        print_plan_ranking(n, ranked, obj.unit)

        best_c, best_plan, _ = ranked[0]
        single = plan_single(n, sizes)
        binary = plan_binary(n, sizes)
        c_single = plan_cost(single, cost)
        c_binary = plan_cost(binary, cost)
        print(f"\n  Optimum          : {plan_str(best_plan)}  "
              f"({best_c:.4f} {obj.unit}, {plan_m(best_plan)} preuves, "
              f"padding {plan_capacity(best_plan) - n})")
        print(f"  vs circuit unique: {plan_str(single)} = {c_single:.4f} {obj.unit} "
              f"({(c_single - best_c) / c_single * 100:+.2f}% évitables)")
        print(f"  vs binaire       : {plan_str(binary)} = {c_binary:.4f} {obj.unit} "
              f"({(c_binary - best_c) / c_binary * 100:+.2f}% évitables)")

        # lecture via le modèle affine : m*rho + padding
        rho = fit.rho(obj.alpha(model))
        print(f"\n  Lecture par le modèle affine (score = m*rho + capacité, rho = {rho:.0f} tx) :")
        for label, plan in (("optimum", best_plan), ("unique", single), ("binaire", binary)):
            score = plan_m(plan) * rho + plan_capacity(plan)
            print(f"    {label:<9} {plan_str(plan):<26} "
                  f"{plan_m(plan)}*{rho:.0f} + {plan_capacity(plan)} = {score:.0f} tx-équiv.")

        if args.csv:
            path = args.csv if len(provers) == 1 else f"{os.path.splitext(args.csv)[0]}_{prover}.csv"
            with open(path, "w", newline="", encoding="utf-8") as f:
                w = csv.writer(f)
                w.writerow(["plan", "m", "capacity", "padding", f"cost_{obj.unit}", "delta_pct", "tag"])
                for c, plan, tag in ranked:
                    cap = plan_capacity(plan)
                    w.writerow([plan_str(plan), plan_m(plan), cap, cap - n,
                                f"{c:.6f}", f"{(c - best_c) / best_c * 100:.4f}", tag])
            print(f"\n  classement écrit dans {path}")


def cmd_validate(args: argparse.Namespace) -> None:
    """Vérifie l'additivité : coût mesuré d'un plan complet vs somme des atomes."""
    model = CostModel.load(args.costs)
    prover = args.prover if args.prover != "both" else model.available_provers()[0]
    obj = objective_from_args(args, prover)
    obj.mode = "time"  # on valide un temps mur, pas un coût monétaire
    cost = build_cost_table(model, obj)
    sizes = sorted(cost)
    results = []

    for n in args.n:
        _, choice = solve_dp(n, cost)
        plans = {
            "opt": reconstruct(n, choice),
            "single": plan_single(n, sizes),
            "binary": plan_binary(n, sizes),
        }
        for spec in args.compare or []:
            plans[f"custom:{spec}"] = parse_plan(spec)

        for name, plan in plans.items():
            missing = [k for k in plan if k not in sizes]
            if missing:
                print(f"[ignoré] {name}: tailles non mesurées {missing}")
                continue
            predicted = plan_cost(plan, cost)
            measured: List[float] = []
            print(f"\n[N={n}] {name} = {plan_str(plan)} — prédiction {predicted:.3f} s")
            for rep in range(args.repeat):
                t0 = time.perf_counter()
                for k in plan_sizes(plan):
                    rel = f"./circuits/{k}"
                    _run([args.snarkjs, "wtns", "calculate",
                          f"{rel}/circuit_js/circuit.wasm", f"{rel}/input.json",
                          f"{rel}/witness.wtns"], REPO_ROOT)
                    if prover == "snarkjs":
                        _run([args.snarkjs, "groth16", "prove",
                              f"{rel}/circuit_final.zkey", f"{rel}/witness.wtns",
                              f"{rel}/proof.json", f"{rel}/public.json"], REPO_ROOT)
                    else:
                        base = args.docker_mount_prefix.rstrip("/")
                        _run(["docker", "exec", args.docker_container,
                              args.docker_prover_path,
                              f"{base}/{k}/circuit_final.zkey", f"{base}/{k}/witness.wtns",
                              f"{base}/{k}/proof.json", f"{base}/{k}/public.json"], REPO_ROOT)
                    if not args.no_verify:
                        _run([args.snarkjs, "groth16", "verify",
                              f"{rel}/verification_key.json", f"{rel}/public.json",
                              f"{rel}/proof.json"], REPO_ROOT)
                dt = time.perf_counter() - t0
                measured.append(dt)
                print(f"    exécution {rep + 1}/{args.repeat} : {dt:.3f} s "
                      f"(écart {100 * (dt - predicted) / predicted:+.1f}%)")
            med = statistics.median(measured)
            results.append({
                "n": n, "strategy": name, "plan": plan_str(plan),
                "predicted_s": predicted, "measured_median_s": med,
                "error_pct": 100 * (med - predicted) / predicted if predicted else 0.0,
                "runs": measured,
            })

    print(f"\n{'N':>6} {'stratégie':<16} {'plan':<26} {'prédit':>9} {'mesuré':>9} {'écart':>8}")
    print("-" * 80)
    for r in results:
        print(f"{r['n']:>6} {r['strategy']:<16} {r['plan'][:26]:<26} "
              f"{r['predicted_s']:>9.3f} {r['measured_median_s']:>9.3f} "
              f"{r['error_pct']:>+7.2f}%")
    if args.out:
        with open(args.out, "w", encoding="utf-8") as f:
            json.dump({"prover": prover, "results": results}, f, indent=2, ensure_ascii=False)
        print(f"\n>>> {args.out}")


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #


def add_objective_args(p: argparse.ArgumentParser) -> None:
    g = p.add_argument_group("fonction de coût")
    g.add_argument("--objective", choices=("time", "usd"), default="time",
                   help="temps mur (défaut) ou coût monétaire (calcul + gas)")
    g.add_argument("--no-witness", action="store_true",
                   help="exclut le calcul du témoin du coût de preuve")
    g.add_argument("--no-verify", action="store_true",
                   help="exclut la vérification (régime prover seul, sans règlement)")
    g.add_argument("--overhead-per-proof", type=float, default=0.0, metavar="S",
                   help="surcoût fixe supplémentaire par preuve, en secondes "
                        "(soumission, agrégation, latence réseau)")
    g.add_argument("--usd-per-hour", type=float, default=0.0,
                   help="prix horaire de la machine de preuve (--objective usd)")
    g.add_argument("--gas-per-proof", type=float, default=DEFAULT_GAS_PER_PROOF,
                   help=f"gas par soumission on-chain (défaut {DEFAULT_GAS_PER_PROOF})")
    g.add_argument("--gas-price-gwei", type=float, default=0.0)
    g.add_argument("--eth-usd", type=float, default=0.0)


def add_figure_args(p: argparse.ArgumentParser) -> None:
    g = p.add_argument_group(
        "figures (qualité publication)",
        "Les figures sont dessinées à leur taille finale dans l'article : la police "
        "vue par le lecteur est exactement --fig-font-size, sans réduction "
        "ultérieure. Un figures.tex prêt à \\input accompagne les images.",
    )
    g.add_argument("--fig-format", nargs="+", default=["png", "pdf"],
                   metavar="EXT",
                   help="formats d'export (défaut : png pdf ; svg, eps possibles)")
    g.add_argument("--fig-dpi", type=int, default=600,
                   help="résolution du PNG (défaut 600 : seuil usuel des éditeurs)")
    g.add_argument("--fig-width", default="single", metavar="W",
                   help="largeur finale : 'single' (3.5 in), 'double' (7.16 in) "
                        "ou une valeur en pouces")
    g.add_argument("--fig-font-size", type=float, default=8.0, metavar="PT",
                   help="taille de police de base, en points (défaut 8)")
    g.add_argument("--fig-titles", action="store_true",
                   help="grave le titre dans la figure (par défaut il n'est "
                        "que dans la légende LaTeX, comme le veut l'usage)")


def add_exec_args(p: argparse.ArgumentParser) -> None:
    g = p.add_argument_group("exécution")
    g.add_argument("--snarkjs", default="snarkjs")
    g.add_argument("--circuits-dir", default=DEFAULT_CIRCUITS_DIR)
    g.add_argument("--docker-container", default="debian_rapidsnark")
    g.add_argument("--docker-prover-path", default="mnt/projet/rapidsnark/package/bin/prover")
    g.add_argument("--docker-mount-prefix", default="mnt/projet")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="optimize_batch_partition.py",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # -- measure ----------------------------------------------------------- #
    m = sub.add_parser("measure", help="mesure les coûts atomiques par taille de circuit")
    m.add_argument("--out", default="bench-out/partition/costs.json")
    m.add_argument("--sizes", default="", help="liste explicite, ex. 1,2,4,8 (défaut : auto)")
    m.add_argument("--prover", choices=("rapidsnark", "snarkjs", "both"), default="both")
    m.add_argument("--repeat", type=int, default=10)
    m.add_argument("--sleep", type=float, default=0.0, help="pause entre exécutions (s)")
    m.add_argument("--warmup", action="store_true", default=True)
    m.add_argument("--no-warmup", dest="warmup", action="store_false")
    add_exec_args(m)
    m.set_defaults(func=cmd_measure)

    # -- import ------------------------------------------------------------ #
    i = sub.add_parser("import", help="convertit un run bench-out/<ts> en modèle de coût")
    i.add_argument("--from", required=True, help="dossier bench-out/<timestamp>")
    i.add_argument("--out", default="bench-out/partition/costs.json")
    i.set_defaults(func=cmd_import)

    # -- analyze ----------------------------------------------------------- #
    a = sub.add_parser("analyze", help="balayage N=1..nmax, figures et tables")
    a.add_argument("--costs", default="bench-out/partition/costs.json")
    a.add_argument("--outdir", default="bench-out/partition")
    a.add_argument("--nmax", type=int, default=DEFAULT_NMAX)
    a.add_argument("--prover", choices=("rapidsnark", "snarkjs", "both"), default="both")
    a.add_argument("--table-n", type=int, nargs="+",
                   default=[100, 1050, 1500, 3000, 5000, 7000, 10000],
                   help="valeurs de N détaillées dans la table LaTeX")
    a.add_argument("--zoom", type=int, nargs=2, default=[1000, 1100],
                   metavar=("LO", "HI"), help="fenêtre du zoom en dents de scie")
    a.add_argument("--no-figures", action="store_true")
    add_figure_args(a)
    add_objective_args(a)
    a.set_defaults(func=cmd_analyze)

    # -- explain ----------------------------------------------------------- #
    e = sub.add_parser("explain", help="classement des plans pour un N donné")
    e.add_argument("n", type=int)
    e.add_argument("--costs", default="bench-out/partition/costs.json")
    e.add_argument("--prover", choices=("rapidsnark", "snarkjs", "both"), default="both")
    e.add_argument("--top", type=int, default=12, help="nombre de plans classés")
    e.add_argument("--node-budget", type=int, default=300_000)
    e.add_argument("--compare", action="append", metavar="PLAN",
                   help="plan imposé à comparer, ex. --compare 1024+16+8+2")
    e.add_argument("--csv", default="", help="écrit le classement dans ce CSV")
    add_objective_args(e)
    e.set_defaults(func=cmd_explain)

    # -- validate ---------------------------------------------------------- #
    v = sub.add_parser("validate", help="exécute réellement des plans et compare au modèle")
    v.add_argument("n", type=int, nargs="+")
    v.add_argument("--costs", default="bench-out/partition/costs.json")
    v.add_argument("--prover", choices=("rapidsnark", "snarkjs", "both"), default="snarkjs")
    v.add_argument("--repeat", type=int, default=3)
    v.add_argument("--compare", action="append", metavar="PLAN")
    v.add_argument("--out", default="")
    add_objective_args(v)
    add_exec_args(v)
    v.set_defaults(func=cmd_validate)

    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
